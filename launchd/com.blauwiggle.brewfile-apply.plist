<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.blauwiggle.brewfile-apply</string>
  <key>ProgramArguments</key>
  <array><string>/bin/sh</string><string>-c</string><string>"$HOME/dotfiles/brewfile-apply.sh"</string></array>
  <key>RunAtLoad</key><true/>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/tmp/brewfile-apply.log</string>
  <key>StandardErrorPath</key><string>/tmp/brewfile-apply.log</string>
</dict>
</plist>
