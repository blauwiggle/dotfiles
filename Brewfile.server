# Server subset — the Mac mini M4 runs remit's host substrate and nothing else:
# no desktop apps, no editors, no office. Install with
#   brew bundle --file=~/dotfiles/Brewfile.server
tap "hashicorp/tap", trusted: true
brew "bat"
brew "cosign"
brew "direnv"
brew "eza"
brew "fzf"
brew "gh"
brew "go"
brew "golangci-lint"
brew "helm"
brew "jq"
brew "node"
brew "k3d"
brew "kubernetes-cli"
brew "starship"
brew "stow"
brew "yq"
brew "zoxide"
brew "hashicorp/tap/terraform"
cask "1password-cli"
cask "claude-code@latest"
brew "colima"
brew "docker"
brew "docker-buildx"
go "github.com/zricethezav/gitleaks/v8"
go "golang.org/x/tools/cmd/goimports"
go "golang.org/x/tools/gopls"
go "golang.org/x/vuln/cmd/govulncheck"

# Editor on the mini: VS Code plus every extension the MacBook has (mirrored from Brewfile).
cask "visual-studio-code"
vscode "bufbuild.vscode-buf"
vscode "cuelangorg.vscode-cue"
vscode "dart-code.dart-code"
vscode "dart-code.flutter"
vscode "drblury.protobuf-vsc"
vscode "eamodio.gitlens"
vscode "esbenp.prettier-vscode"
vscode "figma.figma-vscode-extension"
vscode "github.vscode-github-actions"
vscode "github.vscode-pull-request-github"
vscode "golang.go"
vscode "hashicorp.terraform"
vscode "llvm-vs-code-extensions.lldb-dap"
vscode "mechatroner.rainbow-csv"
vscode "mermaidchart.vscode-mermaid-chart"
vscode "monokai.theme-monokai-pro-vscode"
vscode "ms-azuretools.vscode-azureterraform"
vscode "ms-azuretools.vscode-bicep"
vscode "ms-azuretools.vscode-containers"
vscode "ms-azuretools.vscode-docker"
vscode "ms-dotnettools.vscode-dotnet-runtime"
vscode "ms-python.debugpy"
vscode "ms-python.python"
vscode "ms-python.vscode-python-envs"
vscode "ms-vscode-remote.remote-containers"
vscode "ms-vscode.makefile-tools"
vscode "swiftlang.swift-vscode"
vscode "tilt-dev.tiltfile"
vscode "tomoki1207.pdf"
vscode "yzane.markdown-pdf"

# Terminal: Warp (settings come from defaults/dev.warp.Warp-Stable.plist and warp/settings.toml)
cask "warp"
