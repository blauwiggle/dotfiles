# Server subset — the Mac mini M4 runs remit's host substrate and nothing else:
# no desktop apps, no editors, no office. Install with
#   brew bundle --file=~/dotfiles/Brewfile.server
tap "hashicorp/tap"
brew "bat"
brew "cosign"
brew "direnv"
brew "eza"
brew "fzf"
brew "gh"
brew "go"
brew "golangci-lint"
brew "helm"
brew "jq"
brew "k3d"
brew "kubernetes-cli"
brew "starship"
brew "stow"
brew "yq"
brew "zoxide"
brew "hashicorp/tap/terraform"
cask "1password-cli"
cask "claude-code@latest"
cask "orbstack"
go "github.com/zricethezav/gitleaks/v8"
go "golang.org/x/tools/cmd/goimports"
go "golang.org/x/tools/gopls"
go "golang.org/x/vuln/cmd/govulncheck"
